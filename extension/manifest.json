{
	"manifest_version": 3,
	"name": "鸿鹄易学",
	"version": "4.15.3",
	"description": "鸿鹄易学，支持超星、智慧树、职教云、雨课堂等网课的学习与作业辅助，内置 AI 答题。",
	"default_locale": "zh_CN",
	"minimum_chrome_version": "111",
	"icons": {
		"16": "icon/icon.png",
		"32": "icon/icon.png",
		"48": "icon/icon.png",
		"128": "icon/icon.png"
	},
	"action": {
		"default_icon": {
			"16": "icon/icon.png",
			"32": "icon/icon.png",
			"48": "icon/icon.png",
			"128": "icon/icon.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"storage",
		"notifications",
		"tabs"
	],
	"host_permissions": [
