{
  "$schema": "https://json.schemastore.org/electron-builder.json",
  "appId": "cn.honghutech.honghueasystudy",
  "extraMetadata": {
    "name": "鸿鹄易学",
    "description": "鸿鹄易学 — 浏览器自动化神器，一键浏览器多开，用户脚本环境一键配置。"
  },
  "productName": "鸿鹄易学",
  "asar": false,
  "files": [
    "**/*",
    "!dist/**",
    "!dist-*/**",
    "!**/dist-links/**"
  ],
  "extraResources": [
    {
      "from": "resources/extension",
      "to": "extension",
      "filter": [
        "**/*"
      ]
    }
  ],
  "copyright": "Copyright © 2021 ${author}",
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "icon": "public/favicon.png",
    "artifactName": "鸿鹄易学-${version}-setup-${os}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ],
    "requestedExecutionLevel": "highestAvailable",
    "extraResources": [
      {
        "from": "../../bin/chrome/win-${arch}/",
        "to": "bin/chrome",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/ocr/win-${arch}/",
        "to": "bin/ocr",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/cloudflared/win-${arch}/",
        "to": "bin/cloudflared",
        "filter": [
          "cloudflared*"
        ]
      }
    ]
  },
  "mac": {
    "icon": "public/favicon.icns",
    "artifactName": "鸿鹄易学-${version}-setup-${os}-${arch}.${ext}",
    "target": [
      {
        "target": "dmg"
      }
    ],
    "identity": null,
    "category": "public.app-category.productivity",
    "extraResources": [
      {
        "from": "../../bin/chrome/mac-${arch}/",
        "to": "bin/chrome",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/ocr/mac-${arch}/",
        "to": "bin/ocr",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/cloudflared/mac-${arch}/",
        "to": "bin/cloudflared",
        "filter": [
          "cloudflared*"
        ]
      }
    ]
  },
  "linux": {
    "icon": "public/favicon.png",
    "artifactName": "鸿鹄易学-${version}-setup-${os}-${arch}.${ext}",
    "target": [
      {
        "target": "AppImage"
      },
      {
        "target": "deb"
      },
      {
        "target": "rpm"
      }
    ],
    "category": "Utility",
    "extraResources": [
      {
        "from": "../../bin/chrome/linux-${arch}/",
        "to": "bin/chrome",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/ocr/linux-${arch}/",
        "to": "bin/ocr",
        "filter": [
          "**/*.zip"
        ]
      },
      {
        "from": "../../bin/cloudflared/linux-${arch}/",
        "to": "bin/cloudflared",
        "filter": [
          "cloudflared*"
        ]
      }
    ]
  },
  "deb": {
    "packageName": "honghueasystudy"
  },
  "rpm": {
    "packageName": "honghueasystudy"
  }
}
